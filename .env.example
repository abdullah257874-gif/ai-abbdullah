# ============================================================================
# AI SMART ASSISTANT - ENVIRONMENT CONFIGURATION (.env.example)
# ============================================================================

# GEMINI_API_KEY: Required on the server for Google Gemini AI features.
# Never expose this variable with a VITE_ prefix.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# GEMINI_MODEL: Supported Gemini model alias (defaults to free-quota friendly gemini-3.8-flash).
GEMINI_MODEL="gemini-3.8-flash"

# SESSION_SECRET: Secret key used by the backend to sign user authentication tokens.
SESSION_SECRET="replace-with-a-strong-random-64-char-secret"

# ADMIN_EMAIL: Authorized administrator email for the protected Admin Dashboard.
# Users cannot promote themselves to admin by editing their profile.
ADMIN_EMAIL="admin@example.com"

# APP_URL: Public URL where the application is hosted (used for CORS and links).
APP_URL="http://localhost:3000"

# PORT: Server port (defaults to 3000).
PORT="3000"

# OPTIONAL FIREBASE CONFIGURATION (if switching from built-in encrypted store to Firebase):
# VITE_FIREBASE_API_KEY=""
# VITE_FIREBASE_AUTH_DOMAIN=""
# VITE_FIREBASE_PROJECT_ID=""
# VITE_FIREBASE_APP_ID=""
